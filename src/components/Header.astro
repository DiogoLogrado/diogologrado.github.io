---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
];
---

<header>
  <nav>
    <a href="/" class="logo">DL<span>&gt;_</span></a>
    <ul>
      {navLinks.map(({ href, label }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 1.5rem;
    background: rgba(247, 250, 248, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: var(--mono);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .logo span {
    color: var(--accent);
  }

  .logo:hover {
    opacity: 1;
    color: var(--text);
  }

  ul {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  ul a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color var(--transition);
  }

  ul a:hover {
    color: var(--text);
    opacity: 1;
  }

  @media (max-width: 480px) {
    ul {
      gap: 1.25rem;
    }
  }
</style>
